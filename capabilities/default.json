{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The inspector's main window: core + store plugins and every app command. The overlay window has its own, narrower capability (overlay.json).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "allow-get-backend-name",
    "allow-capture-desktop",
    "allow-start-hover-mode",
    "allow-stop-hover-mode",
    "allow-start-focus-tracking",
    "allow-stop-focus-tracking",
    "allow-get-selector-for-ref",
    "allow-get-property-grid",
    "allow-save-collapse-state",
    "allow-load-collapse-state",
    "allow-show-overlay",
    "allow-hide-overlay",
    "allow-get-overlay-state",
    "allow-show-selector-matches"
  ]
}
